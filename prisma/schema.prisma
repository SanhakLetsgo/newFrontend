generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  accounts      Account[]
  sessions      Session[]
  workoutLogs   WorkoutLog[]
  workoutBattles WorkoutBattle[]
  papers        Paper[]
  paperReviews  PaperReview[]
  paperComments PaperComment[]
  psNotes             PsNote[]
  psTopics            PsTopic[]
  psCodePosts              PsCodePost[]
  psCodePostComments       PsCodePostComment[]
  psTopicMaterials         PsTopicMaterial[]
  codingBattleProblems     CodingBattleProblem[]
  codingBattleSubmissions  CodingBattleSubmission[]
  warningBoardEntries      WarningBoardEntry[]
}

model PsNote {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  date      String
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("ps_notes")
}

model PsTopic {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  title     String
  kind      String   @default("subject") // "subject" | "lesson"
  createdAt DateTime @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  codePosts PsCodePost[]
  materials PsTopicMaterial[]

  @@index([userId])
  @@map("ps_topics")
}

model PsTopicMaterial {
  id        String   @id @default(cuid()) @map("_id")
  topicId   String   @map("topic_id")
  userId    String   @map("user_id")
  kind      String   // "link" | "explanation" | "pdf"
  title     String?  @map("title")
  url       String?  @map("url")
  content   String?  @map("content")
  createdAt DateTime @default(now()) @map("created_at")

  topic PsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
  @@map("ps_topic_materials")
}

model PsCodePost {
  id        String   @id @default(cuid()) @map("_id")
  topicId   String   @map("topic_id")
  userId    String   @map("user_id")
  kind      String   // "solution" | "feedback"
  title     String?  @map("title")
  author    String?  @map("author")
  code      String
  language  String   @default("javascript") @map("language")
  question  String?  @map("question")
  createdAt DateTime @default(now()) @map("created_at")

  topic    PsTopic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments PsCodePostComment[]

  @@index([topicId])
  @@index([userId])
  @@map("ps_code_posts")
}

model PsCodePostComment {
  id         String   @id @default(cuid()) @map("_id")
  codePostId String   @map("code_post_id")
  userId     String   @map("user_id")
  content    String
  code       String?  @map("code")
  language   String?  @default("javascript") @map("language")
  createdAt  DateTime @default(now()) @map("created_at")

  codePost PsCodePost @relation(fields: [codePostId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codePostId])
  @@index([userId])
  @@map("ps_code_post_comments")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkoutLog {
  id          String   @id @default(cuid()) @map("_id")
  userId      String   @map("user_id")
  date        String
  attended    Boolean  @default(false)
  workoutType String?  @map("workout_type")
  reps        Int?     @map("reps")
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  calories    Int?     @map("calories")
  details     Json?    @map("details")
  createdAt   DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([createdAt])
  @@map("workout_logs")
}

model WorkoutBattle {
  id            String   @id @default(cuid()) @map("_id")
  userId        String   @map("user_id")
  sport         String   @map("sport")       // 종목
  participantA  String   @map("participant_a")
  participantB  String   @map("participant_b")
  result        String   @map("result")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("workout_battles")
}

model Paper {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  title     String
  url       String?
  tags      String[] @default([])
  authors   String[] @default([])
  readAt    String   @map("read_at")
  pdfPath   String?  @map("pdf_path")
  mySummary String?  @map("my_summary")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   PaperReview?
  comments PaperComment[]
}

model PaperComment {
  id        String   @id @default(cuid()) @map("_id")
  paperId   String   @map("paper_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("paper_comments")
}

model PaperReview {
  id           String   @id @default(cuid()) @map("_id")
  paperId      String   @unique @map("paper_id")
  userId       String   @map("user_id")
  summary      String?
  contribution String?
  method       String?
  experiment   String?
  limitation   String?
  idea         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodingBattleProblem {
  id               String   @id @default(cuid()) @map("_id")
  title            String   @map("title")
  description      String   @map("description")
  referenceCode    String?  @map("reference_code")
  referenceLanguage String? @default("javascript") @map("reference_language")
  testCases         Json?   @map("test_cases") // [{ input: string, expectedOutput: string }]
  weekStart         String  @map("week_start")
  userId           String   @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions CodingBattleSubmission[]

  @@index([weekStart])
  @@index([userId])
  @@map("coding_battle_problems")
}

model CodingBattleSubmission {
  id          String    @id @default(cuid()) @map("_id")
  problemId   String    @map("problem_id")
  userId      String    @map("user_id")
  code        String    @default("") @map("code")
  language    String    @default("javascript") @map("language")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  executionTimeMs  Int?      @map("execution_time_ms")

  problem CodingBattleProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([problemId])
  @@index([userId])
  @@map("coding_battle_submissions")
}

model WarningBoardEntry {
  id         String   @id @default(cuid()) @map("_id")
  userId     String   @map("user_id")
  targetName String   @map("target_name")
  count      Int      @map("deception_score")
  weight     Int      @default(100) @map("weight")
  memo       String?  @map("memo")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("warning_board_entries")
}
